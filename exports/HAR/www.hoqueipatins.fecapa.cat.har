                             <span class=\\\"day-item\\\">DG<\\/span>\\n                                    <span class=\\\"day-number-item\\\">29<\\/span>\\n                                <\\/div>\\n                            <\\/li>\\n                                                    <li>\\n                                <div class=\\\"date-day-month filter-day  \\\"\\n                                    data-date=\\\"2026-11-30\\\">\\n                                    <span class=\\\"day-item\\\">DL<\\/span>\\n                                    <span class=\\\"day-number-item\\\">30<\\/span>\\n                                <\\/div>\\n                            <\\/li>\\n                                            <\\/ul>\\n                <\\/div>\\n                <div class=\\\"navigate-months\\\">\\n                    <div class=\\\"next-month\\\">\\n                                                <a href=\\\"#\\\" class=\\\"nex-arrow next-month-link\\\" id=\\\"next-month-link\\\"\\n                            data-year=\\\"2026\\\" data-month=\\\"12\\\"\\n                            data-days=\\\"31\\\" data-url=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/themes\\/genesis-child\\\">\\n                            Desembre <span>2026<\\/span>                            <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/themes\\/genesis-child\\/assets\\/img\\/icon-arrow.png\\\" alt=\\\"arrow\\\">\\n                        <\\/a>\\n                    <\\/div>\\n                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n\\n        <div id=\\\"events-list\\\">\\n            <p>No hi ha esdeveniments disponibles per avui.<\\/p>\\n        <\\/div>\\n    <\\/div>\\n<\\/section>\\n\\n\\n<script>\\n    jQuery(document).ready(function($) {\\n        function initializeDynamicContent() {\\n            $(document).on('click', '.toggle-disciplines', function(e) {\\n                e.preventDefault();\\n\\n            });\\n\\n            let selectedDiscipline = '';\\n\\n            $(document).on('click', '.filter-category', function(e) {\\n\\n                e.preventDefault();\\n\\n                $('.filter-category').removeClass('active');\\n                $(this).addClass('active');\\n\\n                selectedDiscipline = $(this).data('category');\\n                const currentMonth = $('.date-current').data('current-month');\\n                const currentYear = $('.date-current').data('current-year');\\n                const baseUrl = $('.date-current').data('url');\\n                const selectedDate = $('.filter-day.active-2').data('date');\\n\\n                $('#events-list').addClass('loading');\\n\\n                $.ajax({\\n                    url: my_ajax_object.ajaxurl,\\n                    type: 'POST',\\n                    data: {\\n                        action: 'load_next_month_events',\\n                        month: currentMonth,\\n                        year: currentYear,\\n                        discipline: selectedDiscipline,\\n                        baseUrl: baseUrl,\\n                        selectedDate: selectedDate\\n                    },\\n                    success: function(response) {\\n                        if (response.success) {\\n                            $('#content-calendar').html(response.data);\\n                        }\\n                        $('#content-calendar').removeClass('loading');\\n                    },\\n                    error: function() {\\n                        $('#content-calendar').removeClass('loading');\\n                    }\\n                });\\n            });\\n            \\/\\/Click ajax days\\n            $(document).on('click', '.filter-day', function(e) {\\n                e.preventDefault();\\n\\n                $('.filter-day').removeClass('active-2');\\n                $(this).addClass('active-2');\\n\\n                const selectedDate = $(this).data('date');\\n                $('#events-list').addClass('loading');\\n\\n                $.ajax({\\n                    url: my_ajax_object.ajaxurl,\\n                    type: 'POST',\\n                    data: {\\n                        action: 'filter_venue_events_by_date',\\n                        date: selectedDate,\\n                        discipline: selectedDiscipline\\n                    },\\n                    success: function(response) {\\n                        if (response.success) {\\n                            $('#events-list').html(response.data);\\n                        } else {\\n                            $('#events-list').html('<p>Error en carregar els esdeveniments.<\\/p>');\\n                        }\\n                        $('#events-list').removeClass('loading');\\n                    },\\n                    error: function() {\\n                        $('#events-list').html('<p>Error en carregar els esdeveniments.<\\/p>');\\n                        $('#events-list').removeClass('loading');\\n                    }\\n                });\\n            });\\n            \\/\\/Click ajax next month\\n            $(document).on('click', '.next-month-link', function(e) {\\n                e.preventDefault();\\n\\n                const nextMonth = $(this).data('month');\\n                const nextYear = $(this).data('year');\\n                const nextMonthDays = $(this).data('days');\\n                const baseUrl = $(this).data('url');\\n\\n                $('#content-calendar').addClass('loading');\\n\\n                $.ajax({\\n                    url: my_ajax_object.ajaxurl,\\n                    type: 'POST',\\n                    data: {\\n                        action: 'load_next_month_events',\\n                        month: nextMonth,\\n                        days: nextMonthDays,\\n                        baseUrl: baseUrl,\\n                        year: nextYear,\\n                        discipline: selectedDiscipline\\n                    },\\n                    success: function(response) {\\n                        $('#content-calendar').removeClass('loading');\\n\\n                        if (response.success) {\\n                            $('#content-calendar').html(response.data);\\n\\n                        } else {\\n                            console.log('Error al cargar el calendario.');\\n                        }\\n                    },\\n                    error: function() {\\n                        $('#content-calendar').removeClass('loading');\\n                        console.log('Error en la solicitud AJAX. asd');\\n                    }\\n                });\\n            });\\n        }\\n        initializeDynamicContent();\\n    });\\n<\\/script>\\n\\n\\n<figure class=\\\"wp-block-image alignwide size-large\\\"><a href=\\\"https:\\/\\/tcequipacions.cat\\/ca\\/2526-fcp\\\"><img decoding=\\\"async\\\" width=\\\"1024\\\" height=\\\"204\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6-1024x204.png\\\" alt=\\\"\\\" class=\\\"wp-image-57572\\\" srcset=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6-1024x204.png 1024w, https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6-300x60.png 300w, https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6-768x153.png 768w, https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6-205x41.png 205w, https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6-480x96.png 480w, https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/08\\/BANNERS-WEB-2-6.png 1506w\\\" sizes=\\\"(max-width: 1024px) 100vw, 1024px\\\" \\/><\\/a><\\/figure>\\n\\n\\n\\r\\n\\t\\t<div  class=\\\"block-1c167160-d366-4148-9c41-2f6f1f775fe1 areoi-element container disciplines-section\\\">\\r\\n\\t\\t\\t\\r\\n\\t\\t\\t\\n\\r\\n\\t\\t<div data-aos-duration=\\\"105