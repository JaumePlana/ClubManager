480x96.png 480w\\\" sizes=\\\"(max-width: 1024px) 100vw, 1024px\\\" \\/><\\/a><\\/figure>\\n\\n\\n    <section data-aos-delay=\\\"300\\\" data-aos-duration=\\\"1000\\\" data-aos=\\\"fade-up\\\" id=\\\"block_ba8e880589f9ed244780229b0950a5ea\\\"\\r\\n        class=\\\"general-fcp noticies-list alignwide \\\">\\r\\n        <div class=\\\"container\\\">\\r\\n            <div class=\\\"row\\\">\\r\\n                                    <div class=\\\"col-12 col-lg-8\\\">\\r\\n                        <div class=\\\"item-noticia destacat\\\">\\r\\n                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                <div class=\\\"item-noticia-img\\\">\\r\\n                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/girona-presenta-el-catalunya-stars-2026-la-gran-festa-del-patinatge-artistic-catala\\/\\\">\\r\\n                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/WhatsApp-Image-2026-11-09-at-15.58.15-scaled.jpeg\\\"\\r\\n                                                alt=\\\"Girona presenta el Catalunya Stars 2026, la gran festa del patinatge art\\u00edstic catal\\u00e0\\\">\\r\\n                                                                            <\\/a>\\r\\n                                <\\/div>\\r\\n                                <div class=\\\"item-noticia-content\\\">\\r\\n                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                        <a\\r\\n                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/girona-presenta-el-catalunya-stars-2026-la-gran-festa-del-patinatge-artistic-catala\\/\\\">Girona presenta el Catalunya Stars 2026, la gran festa del patinatge art\\u00edstic catal\\u00e0<\\/a>\\r\\n                                    <\\/h4>\\r\\n                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                        La novena edici\\u00f3 se celebrar\\u00e0 el 21 de novembre a Fontajau, amb tres equips capitanejats per parelles de refer\\u00e8ncia mundial i una previsi\\u00f3 de m\\u00e9s de 5.000 espectadors.&hellip;                                    <\\/div>\\r\\n\\r\\n                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                        <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/girona-presenta-el-catalunya-stars-2026-la-gran-festa-del-patinatge-artistic-catala\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                    <\\/div>\\r\\n                                <\\/div>\\r\\n                            <\\/div>\\r\\n                        <\\/div>\\r\\n                    <\\/div>\\r\\n                \\r\\n                <div class=\\\"col-12 col-lg-4\\\">\\r\\n                    <div class=\\\"list-noticies-slider\\\">\\r\\n                        <div class=\\\"slider-noticies-js\\\">\\r\\n                                                                                                    <div id_post=\\\"59373\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/tortosa-acull-la-primera-jornada-de-la-lliga-catalana-dstreet\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/foto-street-1.png\\\"\\r\\n                                                                alt=\\\"Tortosa acull la primera jornada de la Lliga Catalana d&#8217;Street\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/tortosa-acull-la-primera-jornada-de-la-lliga-catalana-dstreet\\/\\\">Tortosa acull la primera jornada de la Lliga Catalana d&#8217;Street<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La temporada d&#8217;Skate ja ha comen\\u00e7at amb la competici\\u00f3 disputada aquest cap de setmana a Tortosa. Tot i que una part de la jornada es va veure afectada&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/tortosa-acull-la-primera-jornada-de-la-lliga-catalana-dstreet\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59300\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/vilafranca-i-bell-lloc-lideren-la-classificacio-de-la-nacional-catalana\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/DSC05028-Mejorado-NR-scaled.jpg\\\"\\r\\n                                                                alt=\\\"Vilafranca i Bell-lloc lideren la classificaci\\u00f3 de la Nacional Catalana\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/vilafranca-i-bell-lloc-lideren-la-classificacio-de-la-nacional-catalana\\/\\\">Vilafranca i Bell-lloc lideren la classificaci\\u00f3 de la Nacional Catalana<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        El passat cap de setmana es va disputar la 7\\u00aa jornada de la m\\u00e0xima competici\\u00f3 catalana d\\u2019hoquei patins. A la competici\\u00f3 femenina, el CP Vilafranca es consoliden com&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/vilafranca-i-bell-lloc-lideren-la-classificacio-de-la-nacional-catalana\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59290\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/ja-tenim-els-horaris-i-ordres-de-sortida-del-ix-catalunya-stars\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/PetidierPhoto-60.jpg\\\"\\r\\n                                                                alt=\\\"Ja tenim els horaris i ordres de sortida del IX Catalunya Stars!\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/ja-tenim-els-horaris-i-ordres-de-sortida-del-ix-catalunya-stars\\/\\\">Ja tenim els horaris i ordres de sortida del IX Catalunya Stars!<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        Com ja hem estat anunciant aquests darrers dies, el 21 de novembre Fontajau ser\\u00e0 la seu del patinatge art\\u00edstic, i ja en sabem els horaris. Ser\\u00e0 una jornada&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/ja-tenim-els-horaris-i-ordres-de-sortida-del-ix-catalunya-stars\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59212\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/girona-presenta-el-catalunya-stars-2026-la-gran-festa-del-patinatge-artistic-catala\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/WhatsApp-Image-2026-11-09-at-15.58.15-scaled.jpeg\\\"\\r\\n                                                                alt=\\\"Girona presenta el Catalunya Stars 2026, la gran festa del patinatge art\\u00edstic catal\\u00e0\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/girona-presenta-el-catalunya-stars-2026-la-gran-festa-del-patinatge-artistic-catala\\/\\\">Girona presenta el Catalunya Stars 2026, la gran festa del patinatge art\\u00edstic catal\\u00e0<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La novena edici\\u00f3 se celebrar\\u00e0 el 21 de novembre a Fontajau, amb tres equips capitanejats per parelles de refer\\u00e8ncia mundial i una previsi\\u00f3 de m\\u00e9s de 5.000 espectadors.&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/girona-presenta-el-catalunya-stars-2026-la-gran-festa-del-patinatge-artistic-catala\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59175\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/arrenca-la-lliga-catalana-dinline-freestyle-2026-27\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/LLIGA_FREESTYLE_J1_DINA4-1-scaled.png\\\"\\r\\n                                                                alt=\\\"Arrenca la Lliga Catalana d\\u2019Inline Freestyle 2026-27\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/arrenca-la-lliga-catalana-dinline-freestyle-2026-27\\/\\\">Arrenca la Lliga Catalana d\\u2019Inline Freestyle 2026-27<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La primera jornada de la competici\\u00f3 se celebrar\\u00e0 el 21 de novembre a l\\u2019Institut Escola Flor de Maig de Barcelona, amb proves de Speed, Salts, Battle i Slides.&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/arrenca-la-lliga-catalana-dinline-freestyle-2026-27\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59158\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-cap-de-setmana-mes-solidari-de-la-ma-de-la-fundacio-joan-petit\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/joan-petit-scaled.jpeg\\\"\\r\\n                                                                alt=\\\"El cap de setmana m\\u00e9s solidari, de la m\\u00e0 de la Fundaci\\u00f3 Joan Petit\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-cap-de-setmana-mes-solidari-de-la-ma-de-la-fundacio-joan-petit\\/\\\">El cap de setmana m\\u00e9s solidari, de la m\\u00e0 de la Fundaci\\u00f3 Joan Petit<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La Fundaci\\u00f3 Amics Joan Petit Nens amb C\\u00e0ncer organitza la tercera edici\\u00f3 del cap de setmana solidari en la lluita contra el c\\u00e0ncer infantil. Un any m\\u00e9s la&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-cap-de-setmana-mes-solidari-de-la-ma-de-la-fundacio-joan-petit\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59139\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-patinodrom-de-llica-damunt-acollira-el-vi-trofeu-manel-lahosa-de-patinatge-de-velocitat\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/CARTELL_VL_TROFEU_MANEL-1-scaled.png\\\"\\r\\n                                                                alt=\\\"El Patin\\u00f2drom de Lli\\u00e7\\u00e0 d&#8217;Amunt acollir\\u00e0 el VI Trofeu Manel Lahosa de Patinatge Velocitat\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-patinodrom-de-llica-damunt-acollira-el-vi-trofeu-manel-lahosa-de-patinatge-de-velocitat\\/\\\">El Patin\\u00f2drom de Lli\\u00e7\\u00e0 d&#8217;Amunt acollir\\u00e0 el VI Trofeu Manel Lahosa de Patinatge Velocitat<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        El pr\\u00f2xim 14 de novembre, Lli\\u00e7\\u00e0 d&#8217;Amunt ser\\u00e0 l&#8217;escenari del VI Trofeu Manel Lahosa de patinatge velocitat, una cita que reunir\\u00e0 esportistes en una jornada dedicada a aquesta&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-patinodrom-de-llica-damunt-acollira-el-vi-trofeu-manel-lahosa-de-patinatge-de-velocitat\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59136\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/nova-convocatoria-del-curs-tecnic-del-nivell-2-dhoquei-patins\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/foto-noticia-scaled.jpg\\\"\\r\\n                                                                alt=\\\"NOVA CONVOCAT\\u00d2RIA DEL CURS T\\u00c8CNIC DE NIVELL 2 D\\u2019HOQUEI PATINS\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/nova-convocatoria-del-curs-tecnic-del-nivell-2-dhoquei-patins\\/\\\">NOVA CONVOCAT\\u00d2RIA DEL CURS T\\u00c8CNIC DE NIVELL 2 D\\u2019HOQUEI PATINS<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        L\\u2019Escola Catalana de Formaci\\u00f3 de la Federaci\\u00f3 Catalana de Patinatge obre una nova convocat\\u00f2ria per fer el Curs T\\u00e8cnic de Nivell 2 d\\u2019Hoquei Patins. Ser\\u00e0 en mode h\\u00edbrid,&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/nova-convocatoria-del-curs-tecnic-del-nivell-2-dhoquei-patins\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59039\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-cem-la-guineueta-acull-la-quarta-prova-del-circuit-rollercross-2026\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/11\\/DSC04177-2-scaled.jpg\\\"\\r\\n                                                                alt=\\\"El CEM La Guineueta acull la quarta prova del Circuit RollerCross 2026\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-cem-la-guineueta-acull-la-quarta-prova-del-circuit-rollercross-2026\\/\\\">El CEM La Guineueta acull la quarta prova del Circuit RollerCross 2026<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La pista del CEM La Guineueta, a Barcelona, va ser aquest diumenge 1 de novembre l\\u2019escenari de la quarta prova del Circuit RollerCross 2026, una jornada esportiva que&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/el-cem-la-guineueta-acull-la-quarta-prova-del-circuit-rollercross-2026\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59024\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/creix-larxiu-historic-de-la-federacio-catalana-de-patinatge\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/10\\/Carmona-i-Benjami-Pons-2-scaled.jpeg\\\"\\r\\n                                                                alt=\\\"Creix l\\u2019arxiu hist\\u00f2ric de la Federaci\\u00f3 Catalana de Patinatge\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/creix-larxiu-historic-de-la-federacio-catalana-de-patinatge\\/\\\">Creix l\\u2019arxiu hist\\u00f2ric de la Federaci\\u00f3 Catalana de Patinatge<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        L\\u2019expatinador Joan Carmona ha aportat a la Federaci\\u00f3 Catalana de Patinatge l\\u2019arxiu que el seu pare, Juan Carmona, un dels fundadors del CP Congr\\u00e9s, va anar recollint i&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/creix-larxiu-historic-de-la-federacio-catalana-de-patinatge\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"59015\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/la-lliga-catalana-de-skateboarding-2026-2027-arrenca-a-tortosa-amb-la-primera-jornada-de-street\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/10\\/CARTELL_J1_STREET-1-scaled.jpg\\\"\\r\\n                                                                alt=\\\"La Lliga Catalana de Skateboarding 2026-2027 arrenca a Tortosa amb la primera jornada de Street\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/la-lliga-catalana-de-skateboarding-2026-2027-arrenca-a-tortosa-amb-la-primera-jornada-de-street\\/\\\">La Lliga Catalana de Skateboarding 2026-2027 arrenca a Tortosa amb la primera jornada de Street<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La Lliga Catalana de Skateboarding 2026-2027 ja t\\u00e9 data d\\u2019inici. Tortosa ser\\u00e0 l\\u2019escenari de la primera jornada de la temporada, el pr\\u00f2xim 14 de novembre, amb la disputa&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/la-lliga-catalana-de-skateboarding-2026-2027-arrenca-a-tortosa-amb-la-primera-jornada-de-street\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"58902\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <div class=\\\"item-noticia-img\\\">\\r\\n                                                    <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/obertes-les-inscripcions-per-al-curs-de-tecnic-de-nivell-1-dhoquei-linia-a-barcelona\\/\\\">\\r\\n\\r\\n                                                                                                                    <img decoding=\\\"async\\\" src=\\\"https:\\/\\/www.fcpatinatge.cat\\/wp-content\\/uploads\\/2026\\/10\\/DSC03070-scaled.jpg\\\"\\r\\n                                                                alt=\\\"Obertes les inscripcions per al Curs de T\\u00e8cnic de Nivell 1 d\\u2019Hoquei L\\u00ednia\\\">\\r\\n                                                        \\r\\n                                                    <\\/a>\\r\\n                                                <\\/div>\\r\\n                                                <div class=\\\"item-noticia-content\\\">\\r\\n                                                    <h4 class=\\\"item-noticia-title\\\">\\r\\n                                                        <a\\r\\n                                                            href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/obertes-les-inscripcions-per-al-curs-de-tecnic-de-nivell-1-dhoquei-linia-a-barcelona\\/\\\">Obertes les inscripcions per al Curs de T\\u00e8cnic de Nivell 1 d\\u2019Hoquei L\\u00ednia<\\/a>\\r\\n                                                    <\\/h4>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-excerpt\\\">\\r\\n                                                        La Federaci\\u00f3 Catalana de Patinatge obre les inscripcions per al Curs de T\\u00e8cnic de Nivell 1 d\\u2019Hoquei L\\u00ednia, amb la prova d\\u2019acc\\u00e9s prevista per al 14 de desembre&hellip;                                                    <\\/div>\\r\\n\\r\\n                                                    <div class=\\\"item-noticia-link\\\">\\r\\n                                                        <div class=\\\"item-noticia-link\\\">\\r\\n                                                            <a href=\\\"https:\\/\\/www.fcpatinatge.cat\\/noticia\\/obertes-les-inscripcions-per-al-curs-de-tecnic-de-nivell-1-dhoquei-linia-a-barcelona\\/\\\">LLEGIR M\\u00c9S<\\/a>\\r\\n                                                        <\\/div>\\r\\n                                                    <\\/div>\\r\\n                                                <\\/div>\\r\\n                                            <\\/div>\\r\\n                                        <\\/div>\\r\\n                                                                            <div id_post=\\\"58884\\\" class=\\\"item-noticia\\\">\\r\\n                                            <div class=\\\"item-noticia-inner\\\">\\r\\n                                                <di