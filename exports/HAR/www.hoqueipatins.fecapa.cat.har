          "cookies": [],
          "content": {
            "size": 2921,
            "mimeType": "application/javascript",
            "text": "//link contenedor\ndocument.querySelectorAll('.post-item').forEach(postItem => {\n    const titleElement = postItem.querySelector('.post-item__title a');\n    if (titleElement) {\n        const link = titleElement.href;\n        postItem.addEventListener('click', () => {\n            window.location.href = link;\n        });\n        titleElement.addEventListener('click', (e) => {\n            e.stopPropagation();\n        });\n    }\n});\n\ndocument.querySelectorAll('li.menu-item a').forEach(link => {\n    if (window.location.href.includes(link.href)) {\n      link.style.color = '#d32533';\n    }\n  });\n \n\ndocument.addEventListener('DOMContentLoaded', () => {\nconsole.log('james');   \n    document\n        .querySelectorAll('.fcp-featured-news-swiper')\n        .forEach(block => {\n\n            const autoplay = block.dataset.autoplay === '1';\n            const speed = parseInt(block.dataset.speed);\n\n            const thumbsSwiper = new Swiper(\n                block.querySelector('.news-thumbs'),\n                {\n                    slidesPerView: 2.2,\n                    spaceBetween: 16,\n                    watchSlidesProgress: true,\n\n                    breakpoints: {\n                        768: {\n                            slidesPerView: 4\n                        },\n                        1200: {\n                            slidesPerView: 5\n                        }\n                    }\n                }\n            );\n\n            new Swiper(\n                block.querySelector('.news-main'),\n                {\n                    speed: 700,\n\n                    autoplay: autoplay ? {\n                        delay: speed,\n                        disableOnInteraction: false\n                    } : false,\n\n                    thumbs: {\n                        swiper: thumbsSwiper\n                    }\n                }\n            );\n\n        });\n\n});\n\njQuery(function($){\n\n    $('.wp-block-gallery img').each(function(){\n\n        const $img = $(this);\n\n        if (this.naturalHeight > this.naturalWidth) {\n            $img.closest('.wp-block-image').addClass('portrait');\n        }\n\n        if ($img.parent('a').length) {\n            return;\n        }\n\n        $img.wrap(\n            '<a href=\"' +\n            $img.attr('src') +\n            '\" data-magnific-popup=\"gallery\"></a>'\n        );\n\n    });\n\n    $('.wp-block-gallery .wp-block-image a').each(function(){\n\n        if (!$(this).find('.gallery-overlay').length) {\n            $(this).append('<span class=\"gallery-overlay\"></span>');\n        }\n\n    });\n\n    $('.wp-block-gallery').each(function(){\n\n        const total = $(this).find('.wp-block-image').length;\n\n        if (total <= 3) {\n            $(this).addClass('gallery-few-items');\n        }\n\n    });\n\n    $('.wp-block-gallery').magnificPopup({\n        delegate: 'a[data-magnific-popup=\"gallery\"]',\n        type: 'image',\n        gallery: {\n            enabled: true\n        }\n    });\n\n});"
          },
