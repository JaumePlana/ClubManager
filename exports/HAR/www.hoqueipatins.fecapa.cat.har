 {\n\t\t\t\t\tv = v.startsWith('//') ? 'https:' + v : baseUrl + (v[0] === '/' ? '' : '/') + v;\n\t\t\t\t}\n\t\t\t\tv = v.replace(/^http:\\/\\//i, 'https://');\n\t\t\t\tel.setAttribute(attr, v);\n\t\t\t}\n\t\t});\n\t});\n\n\tconst contentWrapper = sourceDoc.createElement('div');\n\tcontentWrapper.id = \"inner_body\";\n\t\n\tselector.replace(/\"/g, '').split(',').forEach(s => {\n\t\tsourceDoc.querySelectorAll(s.trim()).forEach(n => contentWrapper.appendChild(n.cloneNode(true)));\n\t});\n\n\tconst scriptsMarkup = Array.from(sourceDoc.querySelectorAll('script')).map(s => {\n\t\tconst sc = document.createElement('script');\n\t\tif (s.src) {\n\t\t\tif (s.src.includes('analytics') || s.src.includes('facebook')) return '';\n\t\t\tsc.src = s.src.replace(/^http:\\/\\//i, 'https://');\n\t\t\treturn sc.outerHTML;\n\t\t}\n\t\treturn `<script>try { ${s.textContent.replace(/http:\\/\\//gi, 'https://')} } catch(e) {}<\\/script>`;\n\t}).join('\\n');\n\n\tconst finalHTML = `\n\t<!DOCTYPE html>\n\t<html>\n\t<head>\n\t\t<meta charset=\"UTF-8\">\n\t\t<meta http-equiv=\"Content-Security-Policy\" content=\"upgrade-insecure-requests\">\n\t\t<base target=\"_top\">\n\t\t${sourceDoc.head.innerHTML.replace(/http:\\/\\//gi, 'https://')}\n\t\t${extraStyles.map(url => '<link rel=\"stylesheet\" href=\"'+url+'\">').join('')}\n\t\t<style>\n\t\t\t:root { ${customCSS} } /* <--- Inyectar las variables aquí */\n\t\t\tbody, html { margin: 0; padding: 0; overflow: visible !important; background: transparent !important; }\n\t\t\t#inner_body { width: 100%; display: flow-root; min-height: 1px; position: relative; }\n\t\t\tbody { min-height: 1px; }\n\t\t</style>\n\t</head>\n\t<body>\n\t\t<div id=\"inner_body\">${contentWrapper.innerHTML}</div>\n\t\t${scriptsMarkup}\n\t\t<script>\n\t\t\tlet lastH = 0;\n\t\t\tfunction getRealHeight() {\n\t\t\t\tconst wrapper = document.getElementById('inner_body');\n\t\t\t\tif (!wrapper) return 0;\n\t\t\t\tlet maxHeight = wrapper.offsetHeight;\n\t\t\t\tconst elements = wrapper.getElementsByTagName('*');\n\t\t\t\tfor (let i = 0; i < elements.length; i++) {\n\t\t\t\t\tconst el = elements[i];\n\t\t\t\t\tif (el.offsetWidth <= 0 || el.offsetHeight <= 0) continue;\n\t\t\t\t\tconst style = window.getComputedStyle(el);\n\t\t\t\t\tif (style.display === 'none' || \n\t\t\t\t\t\tstyle.visibility === 'hidden' || \n\t\t\t\t\t\tparseFloat(style.opacity) < 0.1 || \n\t\t\t\t\t\tstyle.pointerEvents === 'none') {\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t\tconst parentSubMenu = el.closest('.sub-menu');\n\t\t\t\t\tif (parentSubMenu) {\n\t\t\t\t\t\tconst menuStyle = window.getComputedStyle(parentSubMenu);\n\t\t\t\t\t\tif (parseFloat(menuStyle.opacity) < 0.1 || menuStyle.pointerEvents === 'none') continue;\n\t\t\t\t\t}\n\t\t\t\t\tconst rect = el.getBoundingClientRect();\n\t\t\t\t\tif (rect.left < -500 || rect.left > window.innerWidth + 500) continue;\n\t\t\t\t\tconst bottom = rect.top + window.scrollY + rect.height;\n\t\t\t\t\tif (bottom > maxHeight && rect.top < maxHeight + 400) maxHeight = bottom;\n\t\t\t\t}\n\t\t\t\treturn Math.ceil(maxHeight);\n\t\t\t}\n\n\t\t\tfunction send() {\n\t\t\t\tconst h = getRealHeight();\n\t\t\t\tif (h > 0 && Math.abs(h - lastH) > 1) {\n\t\t\t\t\tlastH = h;\n\t\t\t\t\twindow.parent.postMessage({ h: h, id: '${uid}' }, \"*\");\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tlet count = 0;\n\t\t\tconst initial = setInterval(() => {\n\t\t\t\tsend();\n\t\t\t\tif (++count > 40) clearInterval(initial);\n\t\t\t}, 100);\n\n\t\t\tif (window.ResizeObserver) new ResizeObserver(send).observe(document.body);\n\t\t\tnew MutationObserver(send).observe(document.body, { attributes: true, childList: true, subtree: true });\n\t\t\t\n\t\t\twindow.addEventListener('load', send);\n\t\t\twindow.addEventListener('mouseover', (e) => {\n\t\t\t\tif (e.target.closest('li, a, button')) send();\n\t\t\t});\n\t\t<\\/script>\n\t</body>\n\t</html>`;\n\tconst iframe = document.getElementById(uid + '_iframe');\n\tconst blob = new Blob([finalHTML], { type: 'text/html' });\n\ti